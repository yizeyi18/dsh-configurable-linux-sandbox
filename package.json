{
  "name": "new-linux-sandbox",
  "version": "0.1.0",
  "description": "A configurable Linux bwrap sandbox provider for DeepSeek Harness: four mount-intent keys, global and per-session configuration",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "build": "tsc -b && tsdown",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -b",
    "link": "sh scripts/link-local-deps.sh"
  },
  "engines": {
    "node": ">=24.9"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.1.0 <5",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1 <0.3",
    "@deepseek-ai/dsh-sandbox": ">=0.2.2-rc.1 <0.3",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.1 <0.3",
    "@deepseek-ai/dsh-session-projection": ">=0.2.2-rc.1 <0.3"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "zod": "4.4.3"
  }
}
